# Kalico (FlashForge-C5-Modding-Group/kalico-ad5x) build config for the AD5X IFS board (FFP0302_Main_Board_V1.0.4)
# TODO: RS485 direction on PA11 (low = transmit) needs a Kalico patch
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_N32G455=y
CONFIG_STM32_FLASH_START_10000=y
CONFIG_STM32_FLASHFORGE_IFS=y
CONFIG_STM32_CLOCK_REF_12M=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=115200
