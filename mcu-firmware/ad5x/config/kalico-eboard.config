# Kalico (FlashForge-C5-Modding-Group/kalico-ad5x) build config for the AD5X toolhead board (eboard, /dev/ttyS5)
# N32G455: kiln-os builds MACH_N32G455xE (mainboard) / MACH_N32G455xC (eboard)
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_N32G455=y
CONFIG_STM32_FLASH_START_10000=y
CONFIG_STM32_CLOCK_REF_12M=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=230400
