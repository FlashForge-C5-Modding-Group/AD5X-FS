# Kalico (FlashForge-C5-Modding-Group/kalico-ad5x) build config for the AD5X mainboard (mcu, /dev/ttyS2)
# N32G455: kiln-os builds MACH_N32G455xE (mainboard) / MACH_N32G455xC (eboard)
#
# Copyright (C) 2026  sterling motuz <Sterling@dexabyte.ca>
#
# Made for the OpenAD5X project
#
# This file may be distributed under the terms of the MIT license.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_N32G455=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_STM32_CLOCK_REF_12M=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=230400
