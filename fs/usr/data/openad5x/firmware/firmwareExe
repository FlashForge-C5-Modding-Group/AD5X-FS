LAUNCHER_LOG="/tmp/openad5x.log"
log_launcher() {
    echo "$1" >> "$LAUNCHER_LOG"
}
log_launcher "firmwareExe is starting..."

# stock app_startup.sh preloads tslib for its Qt screen; the hard-float programs started from here cannot load it
unset LD_PRELOAD

log_launcher "FE: Enabling legacy NaN and mounting Entware..."
sh /usr/data/openad5x/startup/scripts/01-fixnan.sh
if [ ! -x /opt/bin/opkg ] && [ -d /usr/data/bin/opt ] && ! grep -q ' /opt ' /proc/mounts; then
    mount --bind /usr/data/bin/opt /opt
fi

# The AD5X also supports ethernet, hotspot and manual addresses, configured
# in FlashForge's JSON; this block is openad5x's proven network start.
CFG=/usr/prog/config/Adventurer5M.json
WIFI=/usr/prog/wifi
net_get() {
	sed -n '/"network"/,/}/s/.*"'"$1"'" *: *"\{0,1\}\([^",]*\).*/\1/p' "$CFG" | head -n 1
}

set_address() {
	if [ "$(net_get isManual)" = true ]; then
		ifconfig "$1" "$(net_get configIp)" netmask "$(net_get configNetmask)"
		gw=$(net_get configGateway)
		[ -n "$gw" ] && route add default gw "$gw"
		dns=$(net_get configDns)
		[ -n "$dns" ] && echo "nameserver $dns # $1" > /etc/resolv.conf
	else
		udhcpc -b -i "$1" -p /var/run/udhcpc-$1.pid
	fi
}

start_hotspot() {
	ifconfig wlan0 down
	ifconfig wlan0 up
	sleep 1
	ifconfig wlan0 192.168.0.240
	mkdir -p /var/lib/misc/
	touch /var/lib/misc/udhcpd.leases
	udhcpd -I 192.168.0.240
	hostapd -B $WIFI/rtl_hostapd_2G.conf
}

start_wifi() {
	ip addr flush dev eth0
	ifconfig wlan0 down
	killall wpa_supplicant udhcpc 2>/dev/null
	ifconfig wlan0 up
	wpa_supplicant -d -Dnl80211 -iwlan0 -c$WIFI/wpa_supplicant.conf -B
	wpa_cli -i wlan0 enable_network all
	set_address wlan0
}

eth_carrier() { cat /sys/class/net/eth0/carrier 2>/dev/null; }

eth_watch() {
	last=$(eth_carrier)
	while true; do
		sleep 2
		now=$(eth_carrier)
		[ "$now" = "$last" ] && continue
		# only eth0's DHCP client, Wi-Fi keeps its own
		for pid in $(pidof udhcpc); do
			tr '\0' ' ' < /proc/$pid/cmdline | grep -q eth0 && kill $pid
		done
		ip addr flush dev eth0
		if [ "$now" = 1 ]; then
			log_launcher "eth0: cable plugged in"
			set_address eth0
		else
			log_launcher "eth0: cable pulled"
		fi
		last=$now
	done
}

start_ethernet() {
	ifconfig eth0 up
	sleep 1
	[ "$(eth_carrier)" = 1 ] && set_address eth0
	eth_watch &
}

network_start() {
	if [ "$(net_get wifiHotspotStatus)" = true ]; then
		log_launcher "network: hotspot"
		start_hotspot
	elif [ "$(net_get wifiStationStatus)" = true ]; then
		log_launcher "network: wifi"
		start_wifi
	elif [ "$(net_get ethernetStatus)" = true ]; then
		log_launcher "network: ethernet"
		start_ethernet
	elif grep -q 'network=' $WIFI/wpa_supplicant.conf 2>/dev/null; then
		log_launcher "network: wifi (saved network, no mode set)"
		start_wifi
	else
		log_launcher "network: none enabled"
	fi
	# GrumpyScreen's Network tab needs wpa_supplicant's control socket, also on ethernet or with no mode
	if [ "$(net_get wifiHotspotStatus)" != true ] && ! pidof wpa_supplicant >/dev/null 2>&1; then
		ifconfig wlan0 up
		wpa_supplicant -Dnl80211 -iwlan0 -c$WIFI/wpa_supplicant.conf -B
		# no cable: the saved Wi-Fi network needs an address too
		[ "$(eth_carrier)" = 1 ] || udhcpc -b -i wlan0 -p /var/run/udhcpc-wlan0.pid
	fi
}

log_launcher "FE: Starting AD5X network..."
network_start
sleep 10

log_launcher "FE: Launching Startup Scripts..."
/usr/data/openad5x/startup/startup.sh

# startup.sh backgrounds every script and returns at once, so it must only
# run once. app_startup.sh restores the stock binary unless a process named
# firmwareExe is still running, so stay alive.
while true; do
    sleep 3600
done
