#!/bin/sh
# AD5X firmwareExe replacement, meant to bootstrap the initial system and startup the main applications loop
# Brings the network up the way stock does (Adventurer5M.json: Wi-Fi, Ethernet, hotspot or a manual address),
# then hands off to startup.sh @ /usr/data/openad5x/startup/startup.sh
# This also makes it recoverable if startup's script breaks, as you'll still have Wi-Fi / SSH. This is meant to
# run over stock AD5X firmware 3.1.x with the network already set up on the touchscreen.
# Based on the Creator 5 launcher (Tunneled Launcher for Tunneled OpenCreator)

# Copyright (C) 2026  sterling motuz <Sterling@dexabyte.ca>
#
# Made for the OpenAD5X project
#
